graph TB
    subgraph "VK LongPoll API"
        VK[Событие MESSAGE_NEW]
    end

    subgraph "Core Layer"
        EH[EventHandler.handle_event<br/>bot/core/event_handler.py]
        MD[MessageDeduplicator<br/>bot/utils/deduplication.py]
        PRL[PerUserRateLimiter<br/>bot/utils/per_user_limiter.py]
        PI[prompt_injection_check<br/>bot/utils/message_validator.py]
        SM[sanitize_text<br/>bot/utils/message_validator.py]
        MSG[Message.from_vk_event<br/>bot/domains/message.py]
    end

    subgraph "Callback Layer (bot/main.py)"
        CB[on_message callback]
        CM[has_mention<br/>проверка упоминания бота]
        CA[проверка вложений<br/>отклонение с ответом]
    end

    subgraph "Orchestration - MessageProcessor"
        PM1[process<br/>entry point]
        PM2[_prepare_dialog_context]
        PM3[_handle_message]
        PM4[_send_response]
        PM5[_finalize_message]
    end

    subgraph "Processing Layer"
        IC[IntentClassifier.classify_async<br/>bot/services/intent_classifier.py]
        RT[Router<br/>bot/orchestration/router.py<br/>автоматическая регистрация]
        ICM[IntentResult<br/>Pydantic Literal model]
    end

    subgraph "Handlers"
        GH[GreetingHandler<br/>bot/handlers/greeting_handler.py]
        HH[HelpHandler<br/>bot/handlers/help_handler.py]
        DH[DefaultHandler<br/>bot/handlers/default_handler.py]
        TH[ThrowDiceHandler<br/>bot/handlers/throw_dice_handler.py]
    end

    subgraph "Domain Layer"
        DLM[Dialog<br/>user_id, history, context<br/>threading.Lock]
        MSGD[Message<br/>user_id, peer_id, text, timestamp]
    end

    subgraph "Persistence Layer"
        DS[DialogService<br/>LRU cache + SQLite]
        DBD[db.save_dialog<br/>storage/db.py]
        DBA[db.add_message<br/>storage/db.py]
        DBM[db.get_dialog<br/>storage/db.py]
        DBH[db.get_messages<br/>storage/db.py]
    end

    subgraph "Messaging Layer"
        MS[MessageService<br/>bot/services/message_service.py]
        MQ[MessageQueue<br/>threading.Queue]
        MST[MessageSender<br/>фоновый поток]
        VKS[VKClient.send_message<br/>bot/core/vk_client.py]
        RL[RateLimiter<br/>bot/services/rate_limiter.py]
    end

    subgraph "LLM Layer"
        OAI[OpenAIClient<br/>bot/core/openai_client.py<br/>sync + async]
    end

    subgraph "Monitoring"
        MET[MetricsCollector<br/>bot/utils/metrics.py]
        HS[Health API<br/>bot/api.py]
    end

    subgraph "Lifecycle"
        SH[graceful_shutdown<br/>bot/lifecycle/shutdown.py]
    end

    subgraph "Configuration"
        CFG[Settings<br/>bot/config.py<br/>Pydantic + SSRF validation]
    end

    %% Main flow
    VK --> EH
    EH --> MSG
    MSG --> MD

    MD -->|duplicate?| D1{{проверка}}
    D1 -->|да| END1[игнорировать]
    D1 -->|нет| PRL

    PRL -->|limit?| D2{{превышен?}}
    D2 -->|да| END2[игнорировать]
    D2 -->|нет| MSG2[Message объект]

    MSG2 --> PI
    PI -->|injection?| END3[отклонить]
    PI -->|чисто| SM

    SM -->|sanitize| MSG3[валидированное сообщение]
    MSG3 --> CB

    CB --> CM
    CM -->|не упомянут| SKIP[пропустить]
    CM -->|упомянут| CA
    CA -->|есть вложения| RESP1[ответ о неподдержке]
    CA -->|нет вложений| PM1

    %% MessageProcessor flow
    PM1 --> MET
    MET -.->|record_message_received| PM1
    PM1 --> PM2

    PM2 -->|get_dialog_async| DS
    DS -->|кэш hit| DS_CACHED[Dialog из кэша]
    DS -->|кэш miss| DBM
    DBM --> DBH
    DBH --> DS_CACHED
    DS_CACHED --> PM2A[Dialog контекст]
    PM2 --> PM2A

    PM2A --> PM3

    PM3 --> IC
    IC -->|build_prompt| RT
    RT -->|intents list| IC
    IC -->|classify_async| OAI
    OAI -->|structured output| ICM
    ICM -->|intent| RT
    RT -->|router.get| H{{выбор обработчика}}

    H -->|greeting| GH
    H -->|help| HH
    H -->|unknown| DH
    H -->|throw_dice| TH

    GH --> RES[ResponseText]
    HH --> RES
    DH --> RES
    TH --> RES

    RES --> PM4
    PM4 -->|send| MS
    MS --> MQ
    MQ --> MST
    MST -->|wait| RL
    RL --> VKS

    VKS -->|success| MET2[record_message_sent]
    VKS -->|error| RETRY[exponential backoff]
    RETRY -->|attempts < max| MST
    RETRY -->|attempts = max| MET3[record_message_error]

    MET2 --> LOG[логирование]
    MET3 --> LOGERR[логирование ошибки]

    PM5 -->|user message| DBA
    PM5 -->|bot response| DBA2[db.add_message]
    PM5 -->|save dialog| DBD

    %% Health API
    HS -->|/health| STATUS[статус + метрики]
    HS -->|/ready| READY[готовность]
    HS -->|/metrics| PROM[Prometheus format]

    %% Signal handlers
    SIG[SIGINT/SIGTERM] --> SH
    SH -->|stop| MST
    SH -->|disconnect| VK

    %% Dependency Injection from main.py
    CFG -.-> EH
    CFG -.-> DS
    CFG -.-> MS
    CFG -.-> OAI
    OAI -.-> IC
    IC -.-> RT
    MET -.-> PM1
    MET -.-> HS
    DLM -.-> DS

