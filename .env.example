# Токен сообщества VK (создаётся в разделе Работа с API)
VK_GROUP_TOKEN=your_token_here

# ID сообщества (числовой, без "club" или "-" префикса)
VK_GROUP_ID=12345678

# Имя бота для проверки упоминаний
VK_BOT_NAME=Бот

# Опционально: хост и порт (не используются для LongPoll)
BOT_HOST=localhost
BOT_PORT=8000

# Опционально: таймаут сессии диалога в часах
DIALOG_TIMEOUT_HOURS=24
MAX_HISTORY_MESSAGES=10

# Настройки дедупликации сообщений
DEDUP_MAX_SIZE=1000
DEDUP_TTL_SECONDS=300

# Путь к каталогу логов (относительно корня проекта)
LOG_DIR=logs

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# Задержки отправки сообщений (в секундах)
MESSAGE_SEND_DELAY=0.5
MESSAGE_RETRY_DELAY=1.0

# Настройки валидации сообщений
# Максимальная длина сообщения в символах (максимум 40960 — лимит VK API)
MAX_MESSAGE_LENGTH=10000

# Включить защиту от prompt injection атак
ENABLE_PROMPT_INJECTION_PROTECTION=true
